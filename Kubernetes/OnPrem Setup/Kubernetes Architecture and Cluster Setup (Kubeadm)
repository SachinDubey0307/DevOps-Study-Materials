. By AWS create 02 instances (Master and worker nodes)

. RUN THE FOLLOWING COMMAND IN MASTER AND WORKER NODE BOTH

Step 1: Disable swap:

sudo swapoff -a
sudo sed -i '/ swap / s/^/#/' /etc/fstab

Step 2: Load kernel modules

printf "overlay\nbr_netfilter\n" | sudo tee /etc/modules-load.d/k8s.conf
sudo modprobe overlay
sudo modprobe br_netfilter

Step 3: Set network parameters

printf "net.bridge.bridge-nf-call-iptables = 1\nnet.bridge.bridge-nf-call-ip6tables = 1\nnet.ipv4.ip_forward = 1\n" | sudo tee /etc/sysctl.d/k8s.conf
sudo sysctl --system

Step 4: Install containerd:

sudo apt-get update
sudo apt-get install -y apt-transport-https ca-certificates curl gpg containerd
sudo apt-get install docker.io -y
sudo systemctl enable --now docker

Step 5: Configure containerd:

sudo mkdir -p /etc/containerd
containerd config default | sudo tee /etc/containerd/config.toml
sudo sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
sudo systemctl restart containerd
sudo systemctl enable containerd


Step 6: Add the Kubernetes repository (v1.35):

sudo mkdir -p -m 755 /etc/apt/keyrings
curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.35/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.35/deb/ /" | sudo tee /etc/apt/sources.list.d/kubernetes.list


Step 7: Install kubeadm, kubelet, kubectl:

sudo apt-get update
sudo apt-get install -y kubelet kubeadm kubectl
sudo apt-mark hold kubelet kubeadm kubectl
sudo systemctl enable --now kubelet

Step 8: Verify

kubeadm version
kubectl version --client
containerd --version
free -h


