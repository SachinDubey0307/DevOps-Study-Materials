. Disable the swap memory

  sudo swapoff -a
  free -h

--  Disable swap on startup
 
  sudo vim /etc/fstab                     (in Ubuntu 22.04)
  sudo mount -a
  free -h

. Load all the kernel modules on all the nodes 

sudo tee /etc/modules-load.d/containerd.conf <<EOF
overlay
br_netfilter
EOF

  






