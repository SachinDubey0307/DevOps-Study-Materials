            echo "unit testing done"
            }
        }
        stage("build from dockerfile"){
            steps{
               echo "docker file buile done"
            }
        }
        stage("Log in to AWS ECS "){
            steps{
            echo "ECS Log in done"
            }
        }
        stage("push Image to docker hub"){
            steps{
            echo "pushing image done on docker hub"
            }
        }
        stage("Deploye on EKS Cluster"){
            steps{
            echo "Deployment done on EKS Cluster"
            }
        }
        
    }
